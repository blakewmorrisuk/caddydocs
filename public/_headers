/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/caddy.css
  Cache-Control: public, max-age=3600

/caddy.js
  Cache-Control: public, max-age=3600

/review.mp4
  X-Robots-Tag: noindex, noarchive
  Cache-Control: public, max-age=300

/caddy-review.mp4
  X-Robots-Tag: noindex, noarchive
  Cache-Control: public, max-age=300
